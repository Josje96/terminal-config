# ~/.config/ghostty/config.ghostty
# Reload with ctrl+shift+, (or restart). See all options: ghostty +show-config --default --docs

# --- Appearance ---
font-size = 12
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
cursor-style = block
cursor-style-blink = false
# list themes: ghostty +list-themes
theme = light:Ayu Light,dark:Ayu

# --- Mouse ---
# Let apps (tmux, vim, htop...) receive mouse clicks/scroll/drag
mouse-reporting = true
# Hold shift to bypass the app and select text natively (even inside tmux)
mouse-shift-capture = false
mouse-hide-while-typing = true
mouse-scroll-multiplier = precision:0.25,discrete:0.25
# Ctrl+click opens URLs
link-url = true
right-click-action = context-menu
focus-follows-mouse = false

# --- Clipboard ---
copy-on-select = clipboard
# Lets tmux/nvim read the clipboard via OSC 52
clipboard-read = allow
clipboard-write = allow
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true

# --- Behavior ---
# Scrollback size in bytes
scrollback-limit = 50000000
shell-integration = detect
shell-integration-features = cursor,sudo,title
window-save-state = always
confirm-close-surface = true
app-notifications = no-clipboard-copy

# --- Keybinds ---
# Toggle the titlebar / window decorations
keybind = ctrl+shift+h=toggle_window_decorations
